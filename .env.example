# better-auth session signing secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app (used for auth cookies/redirects + the allowed
# origin for sign-in). The dev server port MUST match this port or better-auth
# rejects login with "Invalid origin". `npm run dev` uses 3939 to match.
BETTER_AUTH_URL=http://localhost:3939

# --- Metadata autofill (optional) -------------------------------------------
# Enables the "Search database" (Find metadata) flow in the Add-comic modal.
# Metron API token (Bearer): https://metron.cloud/ account settings.
# See DESIGN.md §4.1 for endpoints, auth, and rate limits.
METRON_API_KEY=

# --- Cover upscaling (optional) ---------------------------------------------
# Path to a Real-ESRGAN binary. Set it and the detail modal grows an "Upscale"
# action; leave it unset and the action isn't rendered at all (same gating as
# METRON_API_KEY above). Install with e.g. `brew install realesrgan-ncnn-vulkan`.
#
# Upscaling INVENTS detail rather than recovering it — 2x usually holds up on
# comic line art, 4x can look synthetic. The pre-upscale cover is kept so the
# result is revertible from the UI.
# UPSCALER_BIN=/opt/homebrew/bin/realesrgan-ncnn-vulkan
# Model name; the anime model is trained on line art and beats the photo ones
# on comic covers. Must be a 4x model — 2x is produced by resampling its output.
# UPSCALER_MODEL=realesrgan-x4plus-anime
# Only needed if the binary can't find its own models directory.
# UPSCALER_MODEL_DIR=

# --- Local state paths (optional) -------------------------------------------
# Where the sqlite db, uploaded covers, and daily logs live. Defaults to
# ./data. The throwaway-instance recipes in AGENTS.md override both so a manual
# check never touches the real collection.
# DATA_DIR=./data
# DATABASE_PATH=./data/comic-board.db

# --- Seed / import accounts (optional) --------------------------------------
# `npm run db:seed` creates (and logs in as) this account; defaults live in
# src/db/seed.ts. `npm run db:import` restores into IMPORT_USER_EMAIL, falling
# back to SEED_USER_EMAIL — that account must already exist.
# SEED_USER_EMAIL=
# SEED_USER_PASSWORD=
# SEED_USER_NAME=
# IMPORT_USER_EMAIL=
